#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

REPO_DIR="$PWD"
BACKUP_DIR="$HOME/appliquidglass-backups/backup-$(date +%Y%m%d-%H%M%S)"

echo "==> Memeriksa repository..."

if [[ ! -d "$REPO_DIR/.git" ]]; then
    echo "ERROR: Jalankan script dari root repository Git."
    echo "Contoh:"
    echo "  cd /path/ke/AppLiquidGlass"
    exit 1
fi

if [[ ! -f "$REPO_DIR/settings.gradle.kts" && ! -f "$REPO_DIR/settings.gradle" ]]; then
    echo "ERROR: File settings.gradle(.kts) tidak ditemukan."
    exit 1
fi

mkdir -p "$BACKUP_DIR"

echo "==> Repository : $REPO_DIR"
echo "==> Backup     : $BACKUP_DIR"

git status --short

echo
echo "==> Mengambil source terbaru..."
git pull --rebase origin main

backup_file() {
    local file="$1"

    if [[ -f "$file" ]]; then
        mkdir -p "$BACKUP_DIR/$(dirname "${file#$REPO_DIR/}")"
        cp -f "$file" "$BACKUP_DIR/${file#$REPO_DIR/}"
    fi
}

replace_if_exists() {
    local file="$1"
    local old="$2"
    local new="$3"

    if [[ -f "$file" ]]; then
        python - "$file" "$old" "$new" <<'PY'
import sys
from pathlib import Path

file = Path(sys.argv[1])
old = sys.argv[2]
new = sys.argv[3]

text = file.read_text(encoding="utf-8")

if old in text:
    text = text.replace(old, new)
    file.write_text(text, encoding="utf-8")
    print(f"Updated: {file}")
else:
    print(f"Skip: pattern not found in {file}")
PY
    fi
}

ROOT_GRADLE="$REPO_DIR/build.gradle.kts"
APP_GRADLE="$REPO_DIR/app/build.gradle.kts"
LIQUID_GLASS="$REPO_DIR/app/src/main/java/com/febri/liquidglass/ui/LiquidGlassCompose.kt"

backup_file "$ROOT_GRADLE"
backup_file "$APP_GRADLE"
backup_file "$LIQUID_GLASS"

echo
echo "==> Memperbaiki root build.gradle.kts..."

if [[ -f "$ROOT_GRADLE" ]]; then
    python - "$ROOT_GRADLE" <<'PY'
from pathlib import Path
import sys

file = Path(sys.argv[1])
text = file.read_text(encoding="utf-8")

if 'id("org.jetbrains.kotlin.plugin.compose")' not in text:
    marker = 'id("org.jetbrains.kotlin.android") version "2.0.21" apply false'

    if marker in text:
        text = text.replace(
            marker,
            marker + '\n    id("org.jetbrains.kotlin.plugin.compose") version "2.0.21" apply false'
        )
    else:
        text = text.replace(
            'plugins {',
            '''plugins {
    id("org.jetbrains.kotlin.plugin.compose") version "2.0.21" apply false''',
            1
        )

    file.write_text(text, encoding="utf-8")
    print("Root Compose compiler plugin added.")
else:
    print("Root Compose compiler plugin already exists.")
PY
fi

echo
echo "==> Memperbaiki app/build.gradle.kts..."

if [[ -f "$APP_GRADLE" ]]; then
    python - "$APP_GRADLE" <<'PY'
from pathlib import Path
import sys

file = Path(sys.argv[1])
text = file.read_text(encoding="utf-8")

if 'id("org.jetbrains.kotlin.plugin.compose")' not in text:
    marker = 'id("org.jetbrains.kotlin.android")'

    if marker in text:
        text = text.replace(
            marker,
            marker + '\n    id("org.jetbrains.kotlin.plugin.compose")',
            1
        )
    else:
        text = text.replace(
            'plugins {',
            '''plugins {
    id("org.jetbrains.kotlin.plugin.compose")''',
            1
        )

# Kotlin 2.x Compose compiler plugin tidak memerlukan composeOptions lama.
start = text.find("composeOptions {")
if start != -1:
    depth = 0
    end = None

    for i in range(start, len(text)):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                end = i + 1
                break

    if end:
        text = text[:start] + text[end:]

# Tambahkan material icons extended jika dependencies sudah memakai Compose.
dependency = 'implementation("androidx.compose.material:material-icons-extended")'

if dependency not in text and "dependencies {" in text:
    text = text.replace(
        "dependencies {",
        f"dependencies {{\n    {dependency}",
        1
    )

file.write_text(text, encoding="utf-8")
print("app/build.gradle.kts updated.")
PY
fi

echo
echo "==> Memperbaiki LiquidGlassCompose.kt..."

if [[ -f "$LIQUID_GLASS" ]]; then
    python - "$LIQUID_GLASS" <<'PY'
from pathlib import Path
import sys
import re

file = Path(sys.argv[1])
text = file.read_text(encoding="utf-8")

# Pastikan import yang diperlukan tersedia.
imports = [
    "import androidx.compose.animation.ContentTransform",
    "import androidx.compose.animation.fadeIn",
    "import androidx.compose.animation.fadeOut",
    "import androidx.compose.animation.togetherWith",
]

for item in imports:
    if item not in text:
        text = item + "\n" + text

# Ikon Explore dan Insights tidak selalu tersedia pada material icons standar.
text = text.replace("Icons.Filled.Explore", "Icons.Filled.Search")
text = text.replace("Icons.Default.Explore", "Icons.Default.Search")
text = text.replace("Icons.Outlined.Explore", "Icons.Outlined.Search")

text = text.replace("Icons.Filled.Insights", "Icons.Filled.Analytics")
text = text.replace("Icons.Default.Insights", "Icons.Default.Analytics")
text = text.replace("Icons.Outlined.Insights", "Icons.Outlined.Analytics")

# Hapus import ikon yang tidak valid jika ada.
text = re.sub(r"^\s*import\s+androidx\.compose\.material\.icons\.(filled|outlined)\.(Explore|Insights)\s*$\n?", "", text, flags=re.MULTILINE)

# Perbaiki bentuk transitionSpec yang salah.
pattern = re.compile(
    r"transitionSpec\s*=\s*\{\s*tween\s*<[^>]+>\s*\([^)]*\)\s*\}",
    re.MULTILINE
)

text = pattern.sub(
    "transitionSpec = { fadeIn() togetherWith fadeOut() }",
    text
)

# Bentuk umum lain: transitionSpec = { tween(...) }
text = re.sub(
    r"transitionSpec\s*=\s*\{\s*tween\s*\([^)]*\)\s*\}",
    "transitionSpec = { fadeIn() togetherWith fadeOut() }",
    text
)

file.write_text(text, encoding="utf-8")
print("LiquidGlassCompose.kt updated.")
PY
else
    echo "WARNING: LiquidGlassCompose.kt tidak ditemukan, dilewati."
fi

echo
echo "==> Memeriksa workflow GitHub Actions..."

for workflow in "$REPO_DIR/.github/workflows/"*.yml "$REPO_DIR/.github/workflows/"*.yaml; do
    [[ -f "$workflow" ]] || continue

    echo "Checking: $workflow"

    # Pastikan checkout menggunakan repository source.
    if grep -q "actions/checkout@" "$workflow"; then
        echo "  checkout: OK"
    fi

    # Jangan menjalankan Gradle lokal; workflow tetap menjadi tempat build.
    if grep -qE "gradle|gradlew" "$workflow"; then
        echo "  Gradle command ditemukan: $workflow"
    fi
done

echo
echo "==> Menampilkan perubahan..."
git diff --stat
git diff -- "$ROOT_GRADLE" "$APP_GRADLE" "$LIQUID_GLASS"

echo
echo "==> Memeriksa status Git..."
git status --short

if git diff --quiet; then
    echo
    echo "Tidak ada perubahan source yang perlu di-commit."
    exit 0
fi

echo
echo "==> Commit perubahan..."
git add \
    build.gradle.kts \
    app/build.gradle.kts \
    app/src/main/java/com/febri/liquidglass/ui/LiquidGlassCompose.kt \
    .github/workflows 2>/dev/null || true

git commit -m "fix: repair Compose source and GitHub Actions build errors"

echo
echo "==> Push ke GitHub..."
git push origin main

echo
echo "=============================================="
echo "SUKSES: Perbaikan source sudah di-push."
echo "GitHub Actions akan melakukan build di runner."
echo "=============================================="
