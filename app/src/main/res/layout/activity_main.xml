<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_root">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:paddingTop="42dp">
        <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good morning" android:textColor="@color/glass_muted" android:textSize="15sp"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Discover your flow." android:textColor="@color/glass_text" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A calm space for ideas, tasks, and inspiration." android:textColor="@color/glass_muted" android:textSize="15sp" android:layout_marginTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/glassCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_glass" android:elevation="8dp">
                <TextView android:id="@+id/cardEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIQUID GLASS SYSTEM" android:textColor="@color/glass_accent" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/cardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Beautifully adaptive." android:textColor="@color/glass_text" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
                <TextView android:id="@+id/cardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Translucent surfaces, soft depth, and expressive motion designed for Android." android:textColor="@color/glass_muted" android:textSize="15sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="86dp" android:padding="4dp">
            <LinearLayout android:id="@+id/navbar" android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="bottom" android:background="@drawable/bg_nav" android:padding="6dp" android:gravity="center" android:orientation="horizontal" android:elevation="12dp">
                <View android:id="@+id/navPill" android:layout_width="0dp" android:layout_height="60dp" android:layout_gravity="start|center_vertical" android:background="@drawable/bg_selected" android:elevation="2dp"/>
                <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="4dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="11sp" android:textColor="#FFFFFF"/></LinearLayout>
                <LinearLayout android:id="@+id/tabExplore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="4dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_compass"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Explore" android:textSize="11sp" android:textColor="#777783"/></LinearLayout>
                <LinearLayout android:id="@+id/tabActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="4dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_activity"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity" android:textSize="11sp" android:textColor="#777783"/></LinearLayout>
                <LinearLayout android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="4dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_settings"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="11sp" android:textColor="#777783"/></LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
